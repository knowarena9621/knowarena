// ═══════════════════════════════════════════════════════════════════════════
// FIRESTORE SECURITY RULES — KnowArena (Test Management Update)
// ═══════════════════════════════════════════════════════════════════════════
// Paste this into Firebase Console → Firestore Database → Rules → Publish.
// ═══════════════════════════════════════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function isStudent() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/students/$(request.auth.uid));
    }

    function studentClass() {
      return get(/databases/$(database)/documents/students/$(request.auth.uid)).data.cls;
    }

    function studentIsApproved() {
      return get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status == "approved";
    }

    // ── teachers/{uid} ────────────────────────────────────────────────────
    match /teachers/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── students/{uid} ────────────────────────────────────────────────────
    // - Student can self-signup (status starts as "pending").
    // - Student can read their own profile.
    // - Only teacher can approve/reject/update/delete.
    // - Read is allowed even when signed out, because the login screen must
    //   resolve "username" -> real email *before* the user is authenticated,
    //   and "Forgot Password" must look up the recovery email the same way.
    //   This does not expose passwords (Firebase Auth stores those
    //   separately, never in Firestore) — only profile fields like name,
    //   class, and recovery email are readable this way.
    match /students/{uid} {
      allow read: if true;

      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.status == "pending";

      allow update, delete: if isTeacher();
    }

    // ── batches/{batchId} ─────────────────────────────────────────────────
    match /batches/{batchId} {
      allow read, write: if isTeacher();
    }

    // ── tests/{testId} ────────────────────────────────────────────────────
    // - Teacher: full access (create draft, edit, publish, archive, delete).
    // - Student: read-only, only PUBLISHED tests matching their class,
    //   and only once approved.
    match /tests/{testId} {
      allow read: if isTeacher() ||
        (isStudent() && studentIsApproved()
          && resource.data.cls == studentClass()
          && resource.data.status == "published");
      allow write: if isTeacher();
    }

    // ── questions/{questionId} ────────────────────────────────────────────
    // - Teacher: full access (create/edit/delete questions, manage bank).
    // - Student: read-only, once approved (test-level access is already
    //   gated by the tests/{testId} rule above; questions are only fetched
    //   for tests the student can already see).
    match /questions/{questionId} {
      allow read: if isTeacher() || (isStudent() && studentIsApproved());
      allow write: if isTeacher();
    }

    // ── questionBank/{questionId} ─────────────────────────────────────────
    // Standalone reusable question bank. Teacher-only (not exposed to
    // students directly; questions are cloned into `questions` when
    // imported into a test).
    match /questionBank/{questionId} {
      allow read, write: if isTeacher();
    }

    // ── attempts/{attemptId} ──────────────────────────────────────────────
    // Document ID convention: "{testId}_{studentUid}"
    // - Student can create their own attempt ONCE (no retake/overwrite).
    // - Teacher can read all attempts (for grading/analytics).
    // - Student can read only their own attempts.
    match /attempts/{attemptId} {
      allow read: if isTeacher() ||
        (isStudent() && resource.data.studentId == request.auth.uid);

      allow create: if isStudent() && studentIsApproved()
        && request.resource.data.studentId == request.auth.uid
        && attemptId == (request.resource.data.testId + "_" + request.auth.uid)
        && !exists(/databases/$(database)/documents/attempts/$(attemptId));

      allow update, delete: if false;
    }

    // ── notices/{noticeId} ────────────────────────────────────────────────
    // Teacher posts notices/announcements (optionally scoped to a class).
    // Students (once approved) can read all notices — class filtering
    // happens client-side. Only the teacher can create/delete.
    match /notices/{noticeId} {
      allow read: if isTeacher() || (isStudent() && studentIsApproved());
      allow create, delete: if isTeacher();
      allow update: if false;
    }

    // ── leaderboard/{cls} ─────────────────────────────────────────────────
    // Read-only for everyone signed in. Written only by Cloud Functions
    // (Admin SDK bypasses these rules).
    match /leaderboard/{cls} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
